# ==============================================================================
# AUTOVIDEO SAAS — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env and configure your environment variables.
# The application functions in offline/fallback mode even with optional keys empty.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & SERVER
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=production
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. SUPER ADMIN CREDENTIALS & SECURITY
# ------------------------------------------------------------------------------
# Generate a strong password and a random 32-byte secret for signing admin session tokens.
ADMIN_USER=admin
ADMIN_PASSWORD=ChangeThisToAStrongPassword2026!#
ADMIN_SECRET=generate_a_random_32_byte_hex_string_for_hmac_signing

# ------------------------------------------------------------------------------
# 3. AI SCRIPT & COPILOT LLM PROVIDERS (Optional — Intelligent fallbacks included)
# ------------------------------------------------------------------------------
# Google Gemini 1.5 Pro / Flash API Key (Get at: https://aistudio.google.com/)
GEMINI_API_KEY=

# OpenAI API Key for GPT-4o Scripting (Get at: https://platform.openai.com/)
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 4. VOICE SYNTHESIS PROVIDERS (Optional — Google Neural & Windows SAPI fallbacks included)
# ------------------------------------------------------------------------------
# ElevenLabs API Key for Ultra-Realistic AI Voices (Get at: https://elevenlabs.io/)
ELEVENLABS_API_KEY=

# ------------------------------------------------------------------------------
# 5. STOCK FOOTAGE & AI IMAGE PROVIDERS (Optional — Procedural Canvas fallbacks included)
# ------------------------------------------------------------------------------
# Pexels API Key for HD Stock Video B-Roll (Get at: https://www.pexels.com/api/)
PEXELS_API_KEY=

# Pixabay API Key for HD B-Roll Clips (Get at: https://pixabay.com/api/docs/)
PIXABAY_API_KEY=

# Cloudflare Workers AI Token for Flux 1 Schnell AI Images (Get at: https://dash.cloudflare.com/)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ------------------------------------------------------------------------------
# 6. GOOGLE OAUTH 2.0 & YOUTUBE DATA API v3 (Required for Auto-Publishing)
# ------------------------------------------------------------------------------
# Configure OAuth 2.0 Web Application credentials at: https://console.cloud.google.com/
# Authorized Redirect URI: http://localhost:3000/api/auth/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/youtube/callback

# Aliases also supported:
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/auth/youtube/callback

# ------------------------------------------------------------------------------
# 7. MONETIZATION & STRIPE PAYMENTS (Optional — Built-in ledger active)
# ------------------------------------------------------------------------------
# Stripe API Keys (Get at: https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ------------------------------------------------------------------------------
# 8. STORAGE & FFMPEG
# ------------------------------------------------------------------------------
# Path to custom FFmpeg binary (Leave empty to use system PATH or bundled binary)
FFMPEG_PATH=
LOCAL_STORAGE_DIR=./storage
